{
  "categories": [
    { "title": "## Breaking Changes 🛠", "labels": ["breaking-change"] },
    { "title": "## New Features 🎉", "labels": ["feature", "feat"] },
    { "title": "## Updated Functionality ⚙", "labels": ["enhancement", "enhancement-provider"] },
    { "title": "## Bug Fixes 🐞", "labels": ["bug", "fix"] },
    { "title": "## Miscellaneous 📚", "labels": ["misc", "docs", "documentation"] }
  ],
  "ignore_labels": ["ignore-for-release", "bot"],
  "template": "#{{CHANGELOG}}",
  "pr_template": "- [#{{NUMBER}}]({{URL}}) - {{TITLE}} (@{{AUTHOR}})",
  "empty_template": "- No changes in this release."
}