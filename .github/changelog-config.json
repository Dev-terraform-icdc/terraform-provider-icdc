{
  "categories": [
    { "title": "## 🚀 New Features", "labels": ["feat", "feature"] },
    { "title": "## 🐛 Bug Fixes", "labels": ["fix", "bug"] },
    { "title": "## 📖 Documentation", "labels": ["docs", "documentation"] },
    { "title": "## 📦 Maintenance & Chore", "labels": ["chore", "build", "ci", "test"] },
    { "title": "## 🧺 Other Changes", "labels": [] }
  ],
  "template": "#{{CHANGELOG}}",
  "pr_template": "- #{{NUMBER}} {{TITLE}} (@{{AUTHOR}})",
  "empty_template": "- No significant changes found.",
  "sort": "ASC",
  "ignore_labels": ["ignore-for-release"],
  "label_extractor": [
    {
      "pattern": "^(feat|fix|docs|chore|build|ci|test)(\\(.+\\))?:.+",
      "target": "$1"
    }
  ]
}